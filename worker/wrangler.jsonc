{
  "name": "labo-outils",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "labo-outils"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projet-db",
      "database_id": "d448bcfa-8ca2-4049-9f41-2f5c732038f9"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://labo.allonsalaplage.workers.dev",
    "TURNSTILE_HOSTNAME": "",
    "TURNSTILE_ACTION": "soumission"
  }
}
