{
  "name": "labo-outils",
  "main": "index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "labo-outils"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://seayousooon.github.io",
    "TURNSTILE_HOSTNAME": "",
    "TURNSTILE_ACTION": "soumission"
  }
}
